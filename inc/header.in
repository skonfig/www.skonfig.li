<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3.org/MarkUp/SCHEMA/xhtml11.xsd" xml:lang="en">
<head>
#include meta.in
<style type="text/css">
	body {
		line-height: 1.25;
	}
	:target, dt:target + dd {
		background-color: #eea;
	}

	@media (prefers-color-scheme: dark) {
		body {
			background-color: #000;
			color: #eee;
		}
		a {color: #6e6eff}
		a:visited {color: #956abd}
	}
</style>
#if test -n "${CUSTOM_CSS-}"
<link rel="stylesheet" type="text/css" href="%{CUSTOM_CSS}" />
#endif
</head>
<body bgcolor="white">
<table border="0" cellpadding="0" cellspacing="0" width="800">
<tr id="header">
<td id="page-title" align="right" valign="bottom" colspan="2">
	<h1>%{META_TITLE}</h1>
</td>
<td rowspan="3" height="100%" width="25">
	<img src="%{PAGE_BASE}img/black.gif" width="1" height="100%" alt="" border="0" align="right" valign="top" />
</td>
<td id="logo" cellpadding="0" width="200">
	<img src="%{PAGE_BASE}img/skonfig_logo.png" height="200" width="200" alt="" valign="bottom" />
</td>
</tr>
<tr>
<td colspan="4">
	<img src="%{PAGE_BASE}img/black.gif" width="100%" height="1" align="top" border="0" alt="" />
</td>
</tr>
<tr>
<td width="20"></td>
<td id="content" valign="top" rowspan="2">
